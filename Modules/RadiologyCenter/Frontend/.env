# ========== Radiology Center Backend ==========
VITE_RADIOLOGY_API_URL=http://localhost:5301/api
VITE_RADIOLOGY_BASE_URL=http://localhost:5301
VITE_RADIOLOGY_API=http://localhost:5301/api

# ========== FHIR — DISABLED (backend not running) ==========
# Uncomment ONLY when FHIR backend is available on port 5301
# VITE_FHIR_SERVER_URL=http://localhost:5301/fhir
# VITE_RADIOLOGY_TOKEN_URL=http://localhost:5301/fhir/token
# VITE_FHIR_CLIENT_ID=clinic-system
# VITE_FHIR_CLIENT_SECRET=clinic-secret

# ========== Clinic System Integration ==========
VITE_CLINIC_API_URL=http://localhost:5201/api
VITE_CLINIC_BASE_URL=http://localhost:5201

# ========== Frontend ==========
VITE_APP_NAME=Radiology Center
VITE_APP_VERSION=1.0.0
VITE_APP_PORT=5174
VITE_ENVIRONMENT=development

# ========== Feature Flags ==========
VITE_ENABLE_SIGNALR=false
VITE_ENABLE_REALTIME=false

# ========== Firebase — REMOVED ==========
# Firebase has been replaced with local auth

# ========== Logging ==========
VITE_LOG_LEVEL=warn
VITE_ENABLE_CONSOLE_LOGS=false