# ========== Radiology Center Backend (FHIR API) ==========
# ASP.NET Core backend running on port 5301 with FHIR endpoints
VITE_RADIOLOGY_API_URL=http://localhost:5301/fhir
VITE_RADIOLOGY_BASE_URL=http://localhost:5301

# FHIR Token endpoint for authentication
VITE_RADIOLOGY_TOKEN_URL=http://localhost:5301/fhir/token

# FHIR client credentials (match RadiologyCenter backend appsettings.json)
VITE_FHIR_CLIENT_ID=clinic-system
VITE_FHIR_CLIENT_SECRET=clinic-secret

# ========== Clinic System Integration ==========
# Clinic backend (for legacy endpoints if needed)
VITE_CLINIC_API_URL=http://localhost:5201/api
VITE_CLINIC_BASE_URL=http://localhost:5201

# ========== Frontend Configuration ==========
VITE_APP_NAME=Radiology Center
VITE_APP_VERSION=1.0.0
VITE_APP_PORT=5178
VITE_ENVIRONMENT=development

# ========== Feature Flags ==========
VITE_ENABLE_SIGNALR=false
VITE_ENABLE_REALTIME=false
VITE_SIGNALR_HUB_URL=http://localhost:5301/hubs/radiology

# ========== Firebase Configuration (Optional) ==========
VITE_FIREBASE_API_KEY=AIzaSyASF5uqrkD7-J98G_aya2y9FmvHj3plFNI
VITE_FIREBASE_AUTH_DOMAIN=eye-clinic-test-ceb22.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eye-clinic-test-ceb22
