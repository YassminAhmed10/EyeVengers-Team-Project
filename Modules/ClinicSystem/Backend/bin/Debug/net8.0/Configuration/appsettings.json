{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "EyeClinicAPI.Services": "Debug",
      "EyeClinicAPI.Modules.Fhir": "Debug"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\mssqllocaldb;Initial Catalog=EyeClinicDB;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "EyeClinicAPI",
    "Audience": "EyeClinicClient"
  },
  "RadiologyCenter": {
    "BaseUrl": "http://localhost:7001",
    "ClientId": "clinic-system",
    "ClientSecret": "clinic-secret",
    "Enabled": true
  },
  "SmtpSettings_disabled": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "EyeClinic@gmail.com",
    "Password": "YOUR_APP_PASSWORD_HERE",
    "FromEmail": "EyeClinic@gmail.com",
    "FromName": "Dr Mohab Khairy Eye Clinic",
    "EnableSsl": "true"
  }
}

